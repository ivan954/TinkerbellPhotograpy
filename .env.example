# Supabase project for the /admin screen. Copy this file to .env and fill in
# the values from Supabase -> Project Settings -> API.
# .env is not committed; in Claude Code cloud sessions the same two variables
# can be set as environment variables instead (see CLAUDE.md).
# Never put the secret / service_role key here.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-or-publishable-key
